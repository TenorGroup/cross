#include <cstdio>

#include "HalTiltSensor.h"

static void updateTiltSensorForForegroundActivity(bool foregroundReader, bool foregroundActivityManagesTiltSensor);

namespace {

unsigned long fakeMillis = 0;

struct FakeImuState {
  bool available = true;
  bool readOk = true;
  bool sleepOk = true;
  bool wakeOk = true;
  float gx = 400.0f;
  float gy = 0.0f;
  float gz = 0.0f;
  int beginCalls = 0;
  int readCalls = 0;
  int sleepCalls = 0;
  int wakeCalls = 0;
} imu;

struct TestSettings {
  uint8_t tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  uint8_t orientation = CrossPointOrientation::PORTRAIT;
  uint8_t tiltStrengthH = 1;  // Medium
  uint8_t tiltStrengthV = 1;
} SETTINGS;

int failures = 0;

bool expect(const bool condition, const char* const scenario, const char* const detail) {
  if (condition) return true;
  std::printf("FAIL %s: %s\n", scenario, detail);
  ++failures;
  return false;
}

void resetSensor() {
  fakeMillis = 0;
  imu = FakeImuState{};
  halTiltSensor = HalTiltSensor{};
  halTiltSensor.begin();
  expect(halTiltSensor.isAvailable(), "setup", "fake IMU must initialize");
}

void runTabTick(const uint8_t tabMode, const bool acceptsTilt = true) {
  updateTiltSensorForForegroundActivity(false, true);
  halTiltSensor.update(tabMode, SETTINGS.orientation, acceptsTilt);
}

// Menu screens poll the horizontal axis and arm the vertical one on the same
// pass; the arming is read by the poll that follows it.
void runMenuTick(const uint8_t tabMode, const uint8_t rowMode, const bool acceptsTilt = true,
                 const bool acceptsRowTilt = true) {
  updateTiltSensorForForegroundActivity(false, true);
  halTiltSensor.update(tabMode, SETTINGS.orientation, acceptsTilt);
  halTiltSensor.configureVerticalGesture(rowMode, acceptsRowTilt);
}

void runReaderTick() { updateTiltSensorForForegroundActivity(true, false); }

void tabReachesForwardTiltAfterOneWake() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  const int sleepAfterBegin = imu.sleepCalls;

  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  }

  expect(imu.wakeCalls == 1, "tab-one-owner", "tab must wake IMU once across stabilization");
  expect(imu.sleepCalls == sleepAfterBegin, "tab-one-owner", "main must not re-sleep active tab IMU");
  expect(halTiltSensor.wasTiltedForward(), "tab-one-owner", "tab must receive forward tilt after stabilization and cooldown");
}

void readerKeepsItsExistingOwner() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_NORMAL;

  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runReaderTick();
  }

  expect(imu.wakeCalls == 1, "reader-owner", "reader must wake IMU once");
  expect(halTiltSensor.wasTiltedForward(), "reader-owner", "reader forward tilt must still fire");
}

void plainActivitySleepsExactlyOnce() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_NORMAL;
  runReaderTick();
  expect(imu.wakeCalls == 1, "plain-activity", "reader setup must wake IMU");

  const int sleepAfterBegin = imu.sleepCalls;
  fakeMillis = 50;
  updateTiltSensorForForegroundActivity(false, false);
  expect(imu.sleepCalls == sleepAfterBegin + 1, "plain-activity", "plain activity must put an awake IMU to sleep");

  fakeMillis = 100;
  updateTiltSensorForForegroundActivity(false, false);
  expect(imu.sleepCalls == sleepAfterBegin + 1, "plain-activity", "sleep must not repeat after IMU is already asleep");
}

void tabOffSleepsThroughTheTabOwner() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  const int sleepAfterBegin = imu.sleepCalls;

  fakeMillis = 50;
  runTabTick(CrossPointTiltPageTurn::TILT_OFF);
  expect(imu.sleepCalls == sleepAfterBegin + 1, "tab-off", "tab Off must sleep an awake IMU");

  fakeMillis = 100;
  runTabTick(CrossPointTiltPageTurn::TILT_OFF);
  expect(imu.sleepCalls == sleepAfterBegin + 1, "tab-off", "tab Off must not repeat sleep");
}

void modalKeepsTheTabLifecycleAndLatch() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  const int sleepAfterBegin = imu.sleepCalls;

  fakeMillis = 400;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL, false);
  expect(imu.sleepCalls == sleepAfterBegin, "tab-modal", "inactive tab modal must retain existing IMU power state");
  expect(!halTiltSensor.wasTiltedForward(), "tab-modal", "modal must discard pending tab tilt events");

  fakeMillis = 650;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  expect(halTiltSensor.wasTiltedForward(), "tab-modal", "resumed tab must complete its original wake and cooldown window");

  fakeMillis = 700;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  expect(!halTiltSensor.wasTiltedForward(), "neutral-latch", "held tilt must not repeat before neutral");

  imu.gx = 0.0f;
  fakeMillis = 750;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  imu.gx = 400.0f;
  fakeMillis = 800;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  expect(!halTiltSensor.wasTiltedForward(), "cooldown", "neutral alone must not bypass cooldown");

  fakeMillis = 1250;
  runTabTick(CrossPointTiltPageTurn::TILT_NORMAL);
  expect(halTiltSensor.wasTiltedForward(), "neutral-latch", "neutral plus cooldown must allow the next tilt");
}

void verticalChannelFiresOnTheOtherAxis() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
  imu.gx = 0.0f;
  imu.gy = 400.0f;  // top edge away from the user

  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  }

  expect(halTiltSensor.wasTiltedDown(), "vertical-axis", "portrait gy must report a step down");
  expect(!halTiltSensor.wasTiltedUp(), "vertical-axis", "one gesture must not fire both directions");
  expect(!halTiltSensor.wasTiltedForward() && !halTiltSensor.wasTiltedBack(), "vertical-axis",
         "the vertical axis must leave the horizontal channel silent");

  // Held past the trigger: one gesture stays one event until neutral plus cooldown.
  fakeMillis = 700;
  runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  expect(!halTiltSensor.wasTiltedDown(), "vertical-latch", "held vertical tilt must not repeat before neutral");

  imu.gy = 0.0f;
  fakeMillis = 750;
  runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  imu.gy = 400.0f;
  fakeMillis = 1250;
  runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  expect(halTiltSensor.wasTiltedDown(), "vertical-latch", "neutral plus cooldown must allow the next vertical tilt");
}

void verticalChannelObeysItsOwnModeAndGate() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
  imu.gx = 0.0f;
  imu.gy = 400.0f;

  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_OFF);
  }
  expect(!halTiltSensor.wasTiltedDown() && !halTiltSensor.wasTiltedUp(), "vertical-off",
         "an Off vertical mode must never emit");

  resetSensor();
  imu.gx = 0.0f;
  imu.gy = 400.0f;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL, true, false);
  }
  expect(!halTiltSensor.wasTiltedDown() && !halTiltSensor.wasTiltedUp(), "vertical-gate",
         "an inactive row target must never emit");

  resetSensor();
  imu.gx = 0.0f;
  imu.gy = 400.0f;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_INVERTED);
  }
  expect(halTiltSensor.wasTiltedUp(), "vertical-inverted", "Inverted must turn the same motion into a step up");
  expect(!halTiltSensor.wasTiltedDown(), "vertical-inverted", "Inverted must not also report a step down");
}

void verticalChannelFollowsOrientationLikeTheHorizontalOne() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  SETTINGS.orientation = CrossPointOrientation::LANDSCAPE_CW;
  imu.gx = 400.0f;  // vertical axis in landscape CW
  imu.gy = 0.0f;

  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_OFF, CrossPointTiltPageTurn::TILT_NORMAL);
  }
  expect(halTiltSensor.wasTiltedDown(), "vertical-orientation", "landscape CW must read the vertical axis off gx");

  resetSensor();
  SETTINGS.orientation = CrossPointOrientation::INVERTED;
  imu.gx = 0.0f;
  imu.gy = 400.0f;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_OFF, CrossPointTiltPageTurn::TILT_NORMAL);
  }
  expect(halTiltSensor.wasTiltedUp(), "vertical-orientation", "an upside-down screen must mirror the vertical axis");
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
}

void readerNeverSeesTheVerticalChannel() {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_NORMAL;
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
  imu.gx = 0.0f;
  imu.gy = 400.0f;

  // A menu pass arms the vertical channel, then the reader takes the foreground.
  runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runReaderTick();
  }
  expect(!halTiltSensor.wasTiltedUp() && !halTiltSensor.wasTiltedDown(), "reader-vertical",
         "the reader route must disarm the vertical channel");
  expect(!halTiltSensor.wasTiltedForward(), "reader-vertical", "vertical motion must not turn a page");
}

// Reader route with a side flick of `gx` dps at the given side strength.
bool readerTurnsAt(const float gx, const uint8_t strength) {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_NORMAL;
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
  SETTINGS.tiltStrengthH = strength;
  imu.gx = gx;
  imu.gy = 0.0f;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runReaderTick();
  }
  return halTiltSensor.wasTiltedForward();
}

// Menu route with an up/down flick of `gy` dps at the given up/down strength.
bool menuRowMovesAt(const float gy, const uint8_t strength) {
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  SETTINGS.orientation = CrossPointOrientation::PORTRAIT;
  SETTINGS.tiltStrengthV = strength;
  imu.gx = 0.0f;
  imu.gy = gy;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_OFF, CrossPointTiltPageTurn::TILT_NORMAL);
  }
  return halTiltSensor.wasTiltedDown();
}

void flickStrengthSetsEachAxisThreshold() {
  // Light 190 dps, Medium 270 dps (the old shared value), Strong 360 dps.
  expect(readerTurnsAt(200.0f, 0), "strength-side", "Light must turn a page at 200 dps");
  expect(!readerTurnsAt(200.0f, 1), "strength-side", "Medium must ignore 200 dps");
  expect(readerTurnsAt(300.0f, 1), "strength-side", "Medium must turn a page at 300 dps");
  expect(!readerTurnsAt(300.0f, 2), "strength-side", "Strong must ignore 300 dps");
  expect(readerTurnsAt(370.0f, 2), "strength-side", "Strong must turn a page at 370 dps");
  expect(!readerTurnsAt(200.0f, 9) && readerTurnsAt(300.0f, 9), "strength-side",
         "an unknown strength must behave as Medium");
  SETTINGS.tiltStrengthH = 1;

  expect(menuRowMovesAt(200.0f, 0), "strength-updown", "Light must move a row at 200 dps");
  expect(!menuRowMovesAt(200.0f, 1), "strength-updown", "Medium must ignore 200 dps");
  expect(!menuRowMovesAt(300.0f, 2), "strength-updown", "Strong must ignore 300 dps");
  expect(menuRowMovesAt(370.0f, 2), "strength-updown", "Strong must move a row at 370 dps");
  SETTINGS.tiltStrengthV = 1;

  // The two axes read their own setting: a Light up/down flick moves a row
  // while the same pass stays below a Strong side threshold.
  resetSensor();
  SETTINGS.tiltPageTurn = CrossPointTiltPageTurn::TILT_OFF;
  SETTINGS.tiltStrengthH = 2;
  SETTINGS.tiltStrengthV = 0;
  imu.gx = 300.0f;
  imu.gy = 200.0f;
  for (fakeMillis = 0; fakeMillis <= 650; fakeMillis += 50) {
    runMenuTick(CrossPointTiltPageTurn::TILT_NORMAL, CrossPointTiltPageTurn::TILT_NORMAL);
  }
  expect(halTiltSensor.wasTiltedDown(), "strength-split", "Light up/down must fire at 200 dps");
  expect(!halTiltSensor.wasTiltedForward(), "strength-split", "Strong side must hold at 300 dps");
  SETTINGS.tiltStrengthH = 1;
  SETTINGS.tiltStrengthV = 1;
}

}  // namespace

unsigned long millis() { return fakeMillis; }

namespace freeink {

bool Imu::begin() {
  ++imu.beginCalls;
  begun_ = imu.available;
  return begun_;
}

bool Imu::read(Sample& out) {
  ++imu.readCalls;
  out = Sample{0.0f, 0.0f, 0.0f, imu.gx, imu.gy, imu.gz};
  return begun_ && imu.readOk;
}

bool Imu::sleep() {
  ++imu.sleepCalls;
  return begun_ && imu.sleepOk;
}

bool Imu::wake() {
  ++imu.wakeCalls;
  return begun_ && imu.wakeOk;
}

}  // namespace freeink

@MAIN_TILT_ROUTE@

int main() {
  tabReachesForwardTiltAfterOneWake();
  readerKeepsItsExistingOwner();
  plainActivitySleepsExactlyOnce();
  tabOffSleepsThroughTheTabOwner();
  modalKeepsTheTabLifecycleAndLatch();
  verticalChannelFiresOnTheOtherAxis();
  verticalChannelObeysItsOwnModeAndGate();
  verticalChannelFollowsOrientationLikeTheHorizontalOne();
  readerNeverSeesTheVerticalChannel();
  flickStrengthSetsEachAxisThreshold();
  std::printf("tilt_sensor_ownership: %d failed assertions\n", failures);
  return failures == 0 ? 0 : 1;
}
