#undef tr
const char* testTranslation(StrId id, const char* name) {
  return id == StrId::STR_BLE_LAST_KEY || id == StrId::STR_BLE_BIND_DONE ? "key %s" : name;
}
#define tr(id) testTranslation(StrId::id, #id)
#define LOG_INF(...) (void)0
#define LOG_ERR(...) (void)0
namespace fui {
struct ListItem {
  const char* label = nullptr;
  const char* value = nullptr;
  int16_t actionValue = 0;
  bool enabled = true;
  bool isHeader = false;
  const char* sectionHeading = nullptr;
};
}
#include "activities/settings/BleKeyBinding.h"
struct CrossPointSettings { static constexpr uint8_t BLE_USAGE_NONE = 0; };
struct Settings {
  bool blePageTurnerEnabled = true;
  char blePeerAddr[18] = {}, blePeerName[32] = {};
  blebinding::RemoteTable bleRemotes[blebinding::kMaxRemotes] = {};
  uint8_t bleRemoteCount = 0;
  int saves = 0;
  void saveToFile() { ++saves; }
} SETTINGS;
uint32_t nowMs = 5000;
uint32_t millis() { return nowMs; }
namespace freeink::ble {
void setIdleStopped(bool) {}
void setReaderStartDeferred(bool) {}
}
namespace backend {
std::vector<std::string> bonds;
std::vector<std::string> devices;
std::vector<std::string> connections;
bool live = false, scan = false;
int begins = 0;
uint8_t bondCount() { return bonds.size(); }
uint8_t deviceCount() { return devices.size(); }
const char* bondAddr(uint8_t i) { return bonds.at(i).c_str(); }
const char* bondName(uint8_t i) { return bonds.at(i).c_str(); }
const char* deviceAddr(uint8_t i) { return devices.at(i).c_str(); }
const char* deviceName(uint8_t i) { return devices.at(i).c_str(); }
bool connected() { return live; }
const char* connectedAddr() { return live ? "AA:BB:CC:DD:EE:F0" : ""; }
const char* connectedName() { return live ? "Remote" : ""; }
bool scanning() { return scan; }
bool begin(int&) { ++begins; return true; }
bool end() { return true; }
void startScan() { scan = true; }
void stopScan() { scan = false; }
void connect(const char* addr) { connections.emplace_back(addr); }
void disconnect() { live = false; }
void forget(const char*) {}
void drainKeys() {}
// Raw edges the remote queued: button code, press or release, time, and whether the
// release showed the press was the remote's rest frame.
struct RawEdge { uint32_t code; bool pressed; uint32_t atMs; bool wasRest; };
std::vector<RawEdge> raw;
bool takeRaw(uint32_t& code, bool& pressed, uint32_t& atMs, bool& wasRest) {
  if (raw.empty()) return false;
  code = raw.front().code; pressed = raw.front().pressed; atMs = raw.front().atMs; wasRest = raw.front().wasRest;
  raw.erase(raw.begin());
  return true;
}
// The screen before the rest flag read edges without it.
bool takeRaw(uint32_t& code, bool& pressed, uint32_t& atMs) { bool wasRest = false; return takeRaw(code, pressed, atMs, wasRest); }
}
void chupChuoi(char* dest, const char* src, size_t maxLen) {
  std::strncpy(dest, src, maxLen - 1); dest[maxLen - 1] = '\0';
}
struct Nav {
  int selected = 0;
  void follow(int) {}
};
struct ButtonNavigator {
  static int nextIndex(int index, int count) { return (index + 1) % count; }
  static int previousIndex(int index, int count) { return (index + count - 1) % count; }
};
struct UiListActivity {
  virtual ~UiListActivity() = default;
  Nav nav;
  Nav& activeNav() { return nav; }
  virtual int listCount() const = 0;
  static int kepConTro(int index, int count) { return std::max(0, std::min(index, count - 1)); }
  void stepSelection(int direction);
};
struct Popup {
  int shows = 0;
  std::vector<StrId> options;
  std::function<void(int)> callback;
  void show(StrId, const StrId* choices, int count, int, std::function<void(int)> f) {
    ++shows; options.assign(choices, choices + count); callback = std::move(f);
  }
};
struct BlePageTurnerActivity : UiListActivity {
  @@ROW_ENUM@@
  BlePageTurnerActivity() = default;
  BlePageTurnerActivity(int&, int&) {}
  int renderer = 0;
  struct App { void clearTapFlash() {} } app;
  Popup optionPopup;
  std::vector<fui::ListItem> rowItems_;
  bool rowsDirty = false, bindWaitActive_ = false;
  std::string bindNotice_, bindValues_[6], statusValue_, statusText_ = "ready";
  uint32_t lastRawCode_ = 0, learnCode_ = 0, learnPressMs_ = 0, bindWaitStartedMs_ = 0;
  blebinding::Action bindAction_ = blebinding::Action::NextPage;
  std::vector<blebinding::Action> waited, cleared;
  int updates = 0;
  int listCount() const override { return rowItems_.size(); }
  void requestUpdate() { ++updates; }
  void capNhatTrangThai() {}
  std::string bindValue(blebinding::Action) const { return "default"; }
  void startBindWait(blebinding::Action a) { bindWaitActive_ = true; waited.push_back(a); }
  void clearBind(blebinding::Action a) { cleared.push_back(a); }
  void clearBindForRow(int index);
  void finishLearn(bool sawRelease, uint32_t heldMs);
  void readPendingKeys();
  void rebuildRows();
  void refreshValues();
  void activateIndex(int index);
  void openPairedPopup(int index);
  void toggleEnabled();
  void handleScanRow();
  void stepSelection(int direction);
  bool clampAfterNav();
};
@@METHODS@@
struct ActivityResult {};
struct Reader {
  int renderer = 0, mappedInput = 0;
  int spine = 3, page = 27, updates = 0;
  std::unique_ptr<BlePageTurnerActivity> child;
  std::function<void(const ActivityResult&)> onReturn;
  void requestUpdate() { ++updates; }
  void startActivityForResult(std::unique_ptr<BlePageTurnerActivity> activity,
                              std::function<void(const ActivityResult&)> callback) {
    child = std::move(activity); onReturn = std::move(callback);
  }
  void activateBluetooth() { @@ROUTE@@ }
};
int failures = 0, checks = 0;
void require(bool condition, const std::string& why) {
  ++checks;
  if (!condition) { ++failures; std::cerr << "FAIL: " << why << '\n'; }
}
int main() {
  using Action = readermenu::Action;
  const Action bluetooth = static_cast<Action>(20);
  const Action legacy[] = {Action::SELECT_CHAPTER, Action::FOOTNOTES, Action::TEXT_SETTINGS, Action::NIGHT_MODE,
    Action::STATUS_BAR, Action::FRONTLIGHT, Action::GO_TO_PERCENT, Action::AUTO_PAGE_TURN, Action::ROTATE_SCREEN,
    Action::BOOKMARKS, Action::TOGGLE_BOOKMARK, Action::SCREENSHOT, Action::DISPLAY_QR, Action::GO_HOME,
    Action::SYNC, Action::DELETE_CACHE, Action::DICTIONARY, Action::FONT_SIZE, Action::FONT_FAMILY, Action::SAVE_QUOTE};
  for (int i = 0; i < 20; ++i) require(static_cast<int>(legacy[i]) == i, "legacy saved action changed");
  require(readermenu::ACTION_COUNT == 24, "File transfer and tilt toggle extend action bounds to 24 after Bluetooth");
  for (int flags = 0; flags < 8; ++flags) {
    std::vector<readermenu::Item> items;
    readermenu::buildItems(items, flags & 1, flags & 2, flags & 4);
    require(std::count_if(items.begin(), items.end(), [&](const auto& i) {
      return i.action == bluetooth && i.tab == readermenu::Tab::TOOLS;
    }) == 1, "exactly one Bluetooth Tools action");
    for (const auto tab : {readermenu::Tab::POSITION, readermenu::Tab::READING, readermenu::Tab::TOOLS}) {
      require(std::count_if(items.begin(), items.end(), [&](const auto& i) { return i.tab == tab; }) <= 20,
              "reader row storage capacity per tab");
    }
    const Action pins[] = {Action::SAVE_QUOTE, bluetooth, Action::SYNC};
    uint8_t indices[3]{};
    const int count = readermenu::rowsOfFavorites(items, pins, 3, indices, 3);
    require(count == 3, "Bluetooth can be pinned with old favorites");
    for (int i = 0; i < count; ++i) require(items[indices[i]].action == pins[i], "pin order retained");
    readermenu::buildMoreItems(items, flags & 1, flags & 2, flags & 4);
    require(std::count_if(items.begin(), items.end(), [&](const auto& i) { return i.action == bluetooth; }) == 1,
            "exactly one Bluetooth More action");
    require(items.size() >= 2 && items[items.size() - 2].action == bluetooth &&
                items.back().action == Action::FILE_TRANSFER,
            "More preserves old order: Bluetooth, then the appended File transfer");
  }
  for (const int bonds : {0, 1, 4}) for (const bool enabled : {false, true}) {
    SETTINGS = {}; SETTINGS.blePageTurnerEnabled = enabled;
    backend::bonds.clear(); backend::devices.clear(); backend::connections.clear(); backend::live = false;
    for (int i = 0; i < bonds; ++i) backend::bonds.push_back("AA:BB:CC:DD:EE:F" + std::to_string(i));
    BlePageTurnerActivity screen;
    screen.rebuildRows(); screen.refreshValues();
    int sectionHeadings = 0;
    for (int i = 0; i < screen.listCount(); ++i) {
      const auto& row = screen.rowItems_[i];
      require(row.actionValue != BlePageTurnerActivity::ROW_PAIRED_HEADER, "paired heading is absent from physical row model");
      if (row.sectionHeading) ++sectionHeadings;
      if (row.actionValue == BlePageTurnerActivity::ROW_STATUS || row.actionValue == BlePageTurnerActivity::ROW_NO_DEVICE) {
        require(!row.enabled, "status/empty is noninteractive for touch");
        screen.activateIndex(i);
        require(screen.optionPopup.shows == 0 && backend::connections.empty(), "status/empty creates no fake popup/connect");
        screen.nav.selected = i; screen.clampAfterNav();
        require(screen.rowItems_[screen.nav.selected].enabled, "page/boundary clamp skips disabled rows");
      }
    }
    require(sectionHeadings == 1, "paired section heading attaches to first bond or empty row");
    for (int direction : {-1, 1}) {
      screen.nav.selected = 0;
      for (int step = 0; step < 2 * screen.listCount(); ++step) {
        screen.stepSelection(direction);
        require(screen.rowItems_[screen.nav.selected].enabled, "physical navigation skips status/empty");
      }
    }
    for (int bond = 0; bond < bonds; ++bond) {
      for (int i = 0; i < screen.listCount(); ++i) {
        if (screen.rowItems_[i].actionValue != BlePageTurnerActivity::ROW_PAIRED_BASE + bond) continue;
        const int shows = screen.optionPopup.shows;
        const size_t calls = backend::connections.size();
        screen.activateIndex(i);
        require(screen.optionPopup.shows == shows + 1 && screen.optionPopup.options.size() == 2, "actual paired row opens two choices");
        screen.optionPopup.callback(0);
        require(SETTINGS.blePeerAddr == backend::bonds[bond], "selected exact address saved");
        require(backend::connections.size() == calls + (enabled ? 1 : 0), "connect dispatch respects enabled setting");
        if (enabled) require(backend::connections.back() == backend::bonds[bond], "connect dispatch uses selected exact address");
      }
    }
  }
  {
    // Six bind rows right after the scan row: next page, previous page, next chapter,
    // previous chapter, reader menu, save quotation. A tap listens for that row's
    // action; a hold clears exactly it.
    SETTINGS = {};
    backend::bonds.assign({"AA:BB:CC:DD:EE:F0"}); backend::devices.clear(); backend::live = true;
    BlePageTurnerActivity screen;
    screen.rebuildRows(); screen.refreshValues();
    const blebinding::Action order[6] = {blebinding::Action::NextPage,    blebinding::Action::PrevPage,
                                         blebinding::Action::NextChapter, blebinding::Action::PrevChapter,
                                         blebinding::Action::ReaderMenu,  blebinding::Action::SaveQuote};
    const char* labels[6] = {"STR_BLE_BIND_NEXT", "STR_BLE_BIND_PREV", "STR_BLE_BIND_NEXT_CHAPTER",
                             "STR_BLE_BIND_PREV_CHAPTER", "STR_BLE_BIND_READER_MENU", "STR_BLE_BIND_SAVE_QUOTE"};
    int scanRow = -1;
    for (int i = 0; i < screen.listCount(); ++i)
      if (screen.rowItems_[i].actionValue == BlePageTurnerActivity::ROW_SCAN) scanRow = i;
    const bool sixRows = scanRow >= 0 && scanRow + 6 < screen.listCount();
    require(sixRows, "bind rows follow the scan row");
    for (int k = 0; sixRows && k < 6; ++k) {
      require(std::strcmp(screen.rowItems_[scanRow + 1 + k].label, labels[k]) == 0, "bind row label in order");
    }
    for (int k = 0; sixRows && k < 6; ++k) {
      const int row = scanRow + 1 + k;
      require(screen.rowItems_[row].enabled && screen.rowItems_[row].value != nullptr, "bind row is live and shows a value");
      screen.activateIndex(row);
      require(screen.waited.size() == static_cast<size_t>(k + 1) && screen.waited.back() == order[k],
              "tapping a bind row listens for its own action");
      screen.clearBindForRow(row);
      require(screen.cleared.size() == static_cast<size_t>(k + 1) && screen.cleared.back() == order[k],
              "holding a bind row clears its own action");
    }
    screen.clearBindForRow(0);
    require(screen.cleared.size() == 6, "holding a non-bind row clears nothing");
    // Forgetting a device forgets its button table too.
    blebinding::editableTable(SETTINGS.bleRemotes, SETTINGS.bleRemoteCount, "AA:BB:CC:DD:EE:F0", "Remote");
    require(SETTINGS.bleRemoteCount == 1, "table setup");
    for (int i = 0; i < screen.listCount(); ++i) {
      if (screen.rowItems_[i].actionValue != BlePageTurnerActivity::ROW_PAIRED_BASE) continue;
      screen.activateIndex(i);
      screen.optionPopup.callback(1);
    }
    require(SETTINGS.bleRemoteCount == 0, "forgetting a device keeps its binding table");
    // The link drops while the screen waits for the release: nothing is learned and
    // the notice says no button arrived. "No room" would send the user to clear rows.
    SETTINGS = {}; backend::live = false;
    screen.bindWaitActive_ = true; screen.learnCode_ = 0x030102; screen.bindAction_ = blebinding::Action::NextChapter;
    screen.finishLearn(true, 60);
    require(SETTINGS.bleRemoteCount == 0 && SETTINGS.saves == 0, "a lost link still wrote a table");
    require(screen.bindNotice_ == "STR_BLE_BIND_NONE", "a lost link was reported as a full table");
    backend::live = true;
    screen.bindWaitActive_ = true; screen.learnCode_ = 0x030102;
    screen.finishLearn(true, 60);
    require(SETTINGS.bleRemoteCount == 1 && SETTINGS.saves == 1 && screen.bindNotice_ == "key 3:1=02",
            "a learned button on a live link was not stored and shown");
    backend::live = false;
  }
  {
    // Learning never stores a remote's rest frame as a button. A remote resting on a
    // non-zero status byte, with no state report on connecting, reads its first press
    // as that byte; the release that shows the rest frame says so, and the screen keeps
    // waiting for the next press, which is the button.
    SETTINGS = {}; backend::live = true; nowMs = 5000;
    BlePageTurnerActivity screen;
    screen.bindWaitActive_ = true; screen.bindWaitStartedMs_ = nowMs; screen.bindAction_ = blebinding::Action::ReaderMenu;
    backend::raw = {{0x000012, true, 5100, false}, {0x000012, false, 5160, true}};
    screen.readPendingKeys();
    require(SETTINGS.bleRemoteCount == 0 && SETTINGS.saves == 0, "the rest frame was learned as a button");
    require(screen.bindWaitActive_ && screen.learnCode_ == 0, "the wait ended on the rest frame");
    require(screen.lastRawCode_ == 0, "the rest frame is shown as the last button");
    nowMs = 6000;
    backend::raw = {{0x000104, true, 5900, false}, {0x000104, false, 5960, false}};
    screen.readPendingKeys();
    require(SETTINGS.bleRemoteCount == 1 && SETTINGS.bleRemotes[0].count == 1 &&
                SETTINGS.bleRemotes[0].bindings[0] ==
                    blebinding::makeBinding(0x000104, false, blebinding::Action::ReaderMenu),
            "the press after the rest frame was not learned");
    require(!screen.bindWaitActive_, "learning did not end on the real button");
    // A remote resting on zeros: its first press is the button, learned at once.
    SETTINGS = {};
    screen.bindWaitActive_ = true; screen.bindWaitStartedMs_ = nowMs; screen.bindAction_ = blebinding::Action::SaveQuote;
    backend::raw = {{0x030102, true, 6100, false}, {0x030102, false, 6160, false}};
    screen.readPendingKeys();
    require(SETTINGS.bleRemoteCount == 1 && SETTINGS.bleRemotes[0].count == 1 &&
                SETTINGS.bleRemotes[0].bindings[0] ==
                    blebinding::makeBinding(0x030102, false, blebinding::Action::SaveQuote),
            "a zero-rest remote's first press was not learned");
    backend::live = false;
  }
  Reader reader;
  reader.activateBluetooth();
  require(reader.child != nullptr, "reader route opens existing Bluetooth activity");
  if (reader.onReturn) { reader.child.reset(); reader.onReturn(ActivityResult{}); }
  require(reader.spine == 3 && reader.page == 27, "Bluetooth return preserves reader position");
  require(reader.updates == 1, "Bluetooth return requests reader repaint");
  std::cout << checks << " checks, " << failures << " failures\n";
  return failures ? 1 : 0;
}
