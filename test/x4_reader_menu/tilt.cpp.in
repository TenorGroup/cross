// Tilt in the reader's menu: the production handleOverlayInput and menutilt::pollTabs against a fake sensor.
// Built for the X4 Pro (its bar, no side buttons) and for the button boards, with the toolbar menu and the X3 bar.
#include <FreeInkApp.h>
#include <MenuTiltInput.h>
#include <ReaderFontSizes.h>

#include <algorithm>
#include <atomic>
#include <cstdio>
#include <functional>
#include <memory>
#include <string>
#include <vector>

enum class StrId { STR_READER_TAB_FAVORITES, STR_TOOL_CONTENTS, STR_TOOL_TEXT, STR_TOOL_MORE };
CrossPointSettings SETTINGS;
HalTiltSensor halTiltSensor;
namespace readermenu {
@TABS@
@TOOLS@
inline constexpr int TOOL_COUNT = 4;
inline constexpr int X3_TAB_COUNT = 5;
inline constexpr unsigned long GIU_GHIM_MS = 1000;
}  // namespace readermenu
