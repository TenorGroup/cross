struct FontSystem {
  SdCardFontRegistry data;
  SdCardFontRegistry& registry() { return data; }
};
// The buttons a case sets: released this pass, held down for `heldMs`. wasLongPressed answers as the real one does:
// once per press, and the press's release is then swallowed (`swallowed`).
class MappedInputManager {
 public:
  enum class Button { Back, Left, Right, Up, Down, Confirm };
  enum class SwipeDir { None, Up, Down };
  mutable std::set<int> released, pressed, fired, swallowed;
  mutable std::vector<std::pair<int, unsigned long>> asked;
  unsigned long heldMs = 0;
  bool wasReleased(Button b) const { return released.count(static_cast<int>(b)) != 0; }
  bool isPressed(Button b) const { return pressed.count(static_cast<int>(b)) != 0; }
  bool wasLongPressed(Button b, unsigned long ms) const {
    asked.push_back({static_cast<int>(b), ms});
    const int key = static_cast<int>(b);
    if (!isPressed(b) || fired.count(key) || heldMs < ms) return false;
    fired.insert(key);
    swallowed.insert(key);
    return true;
  }
  void letGo() { released.clear(); pressed.clear(); fired.clear(); swallowed.clear(); asked.clear(); heldMs = 0; }
  int getHeldTime() const { return static_cast<int>(heldMs); }
  bool wasScreenTouchReleased() const { return false; }
  SwipeDir wasSwipe() const { return SwipeDir::None; }
  void resetHomeButtonInput() {}
};
struct Renderer {
  int getScreenWidth() const { return 480; }
  int getScreenHeight() const { return 800; }
  int getOrientation() const { return 2; }
  void restoreBwBuffer(bool) {}
  bool storeBwBuffer() { return true; }
};
