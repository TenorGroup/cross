  enum class SwipeDir { None, Up, Down };
  bool wasReleased(Button) const { return false; }
  bool isPressed(Button) const { return false; }
  bool wasLongPressed(Button, unsigned long) const { return false; }
  int getHeldTime() const { return 0; }
  bool wasScreenTouchReleased() const { return false; }
  SwipeDir wasSwipe() const { return SwipeDir::None; }
  void resetHomeButtonInput() {}
};
struct Renderer {
  int getScreenWidth() const { return 480; }
  int getScreenHeight() const { return 800; }
  int getOrientation() const { return 2; }
  void restoreBwBuffer(bool) {}
  bool storeBwBuffer() { return true; }
};
struct Toc {
  int spineIndex = 0;
  std::string anchor;
};
struct Epub {
  Toc getTocItem(int) { return {}; }
  int getSpineItemsCount() { return 10; }
  int getTocItemsCount() { return 10; }
};
struct Popup {
  bool on = false;
  bool isActive() const { return on; }
  template <class F>
  void handleInput(MappedInputManager&, F) {}
};
struct ButtonNavigator {
  static int previousIndex(int i, int n) { return (i + n - 1) % n; }
  static int nextIndex(int i, int n) { return (i + 1) % n; }
};
