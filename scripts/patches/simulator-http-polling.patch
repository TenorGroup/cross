+namespace sim_http_client_detail {
+inline void poll(SimEspHttpClient *handle) {
+  if (!handle->multi || handle->done) return;
+  if (handle->config.event_handler) {
+    esp_http_client_event_t event{};
+    event.event_id = HTTP_EVENT_ON_DATA;
+    event.client = handle;
+    event.user_data = handle->config.user_data;
+    handle->config.event_handler(&event);
+  }
+  int running = 0;
+  if (curl_multi_perform(handle->multi, &running) != CURLM_OK) {
+    handle->failed = handle->done = true;
+    return;
+  }
+  int remaining;
+  while (CURLMsg *message = curl_multi_info_read(handle->multi, &remaining)) {
+    if (message->msg != CURLMSG_DONE) continue;
+    handle->failed = message->data.result != CURLE_OK;
+    handle->done = true;
+  }
+}
+inline void release(SimEspHttpClient *handle) {
+  if (handle->multi && handle->easy) curl_multi_remove_handle(handle->multi, handle->easy);
+  if (handle->easy) curl_easy_cleanup(handle->easy);
+  if (handle->multi) curl_multi_cleanup(handle->multi);
+  curl_slist_free_all(handle->requestHeaders);
+  handle->easy = nullptr; handle->multi = nullptr; handle->requestHeaders = nullptr;
+  handle->socket = CURL_SOCKET_BAD;
+}
