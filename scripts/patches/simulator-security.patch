+void WebSocketsServer::onValidateHttpHeader(std::function<bool(String, String)> validator, const char* mandatory[], size_t count) {
+  validator_ = std::move(validator);
+  mandatory_.clear();
+  for (size_t i = 0; i < count; ++i) mandatory_.emplace_back(mandatory[i]);
+}
