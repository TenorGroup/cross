#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./bin/clang-format-fix [--check | --fix] [-g] [-- <git pathspec>...]

  --check       Report formatting errors without changing files (default).
  --fix         Apply formatting to the selected files.
  -g, --changed Select staged, unstaged, and untracked files only.
  -h, --help    Show this help without running the formatter.

Generated fonts, hyphenation data, and vendored sources are excluded.
Requires clang-format 21 or newer, including the Xcode toolchain on macOS.
EOF
}

mode=""
changed=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--fix)
      if [[ -n "$mode" && "$mode" != "$1" ]]; then
        printf '%s\n' 'Choose either --check or --fix.' >&2
        exit 2
      fi
      mode="$1"
      ;;
    -g|--changed) changed=true ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
mode="${mode:---check}"

# Keep git's NUL-delimited names intact, including whitespace and newlines.
file_list="$(mktemp "${TMPDIR:-/tmp}/cross-clang-format.XXXXXX")"
trap 'rm -f "$file_list"' EXIT
if "$changed"; then
  git ls-files -z --modified --others --exclude-standard -- "$@" > "$file_list"
  git diff --cached --name-only --diff-filter=ACMRTUXB -z -- "$@" >> "$file_list"
else
  git ls-files -z --cached --exclude-standard -- "$@" > "$file_list"
fi

files=()
while IFS= read -r -d '' path; do
  case "$path" in
    lib/EpdFont/builtinFonts/*|lib/Epub/Epub/hyphenation/generated/*|lib/uzlib/*|third_party/*|lib/miniz/third_party/*)
      continue ;;
    *.c|*.cpp|*.h|*.hpp) ;;
    *) continue ;;
  esac
  [[ -f "$path" ]] || continue
  duplicate=false
  if [[ ${#files[@]} -gt 0 ]]; then
    for existing in "${files[@]}"; do
      if [[ "$existing" == "$path" ]]; then duplicate=true; break; fi
    done
  fi
  if ! "$duplicate"; then files+=("$path"); fi
done < "$file_list"
[[ ${#files[@]} -gt 0 ]] || exit 0

if command -v clang-format-21 >/dev/null 2>&1; then
  formatter="$(command -v clang-format-21)"
elif command -v clang-format >/dev/null 2>&1; then
  formatter="$(command -v clang-format)"
elif command -v xcrun >/dev/null 2>&1; then
  formatter="$(xcrun --find clang-format)"
else
  printf '%s\n' 'Install clang-format 21 or newer, or select an Xcode toolchain.' >&2
  exit 1
fi

version="$("$formatter" --version)"
if [[ ! "$version" =~ ([0-9]+)\. || "${BASH_REMATCH[1]:-0}" -lt 21 ]]; then
  printf 'clang-format 21 or newer is required: %s\n' "$version" >&2
  exit 1
fi

if [[ "$mode" == '--fix' ]]; then
  "$formatter" --style=file -i -- "${files[@]}"
else
  "$formatter" --style=file --dry-run --Werror -- "${files[@]}"
fi
